#!/usr/bin/env bash
# claude-sessions — cross-project Claude Code session picker.
#
# Lists every session under <config-dir>/projects, for each Claude config dir
# in CS_CONFIG_DIRS (all projects, newest first)
# in fzf. Enter opens the highlighted session in its own window running
# `claude --resume <id>` interactively (so its summary-vs-full prompt appears
# there), while the picker stays open for the next one:
#   - inside tmux  -> new tmux window
#   - otherwise    -> new TAB in the current iTerm window (Terminal.app fallback)
#
# Keys: enter=open  ctrl-a=hide agents  ctrl-s=full-text search  ctrl-r=refresh/back  esc=quit
set -euo pipefail

# BASH_SOURCE is unset when piped (curl ... | bash -s -- --install)
SELF="${BASH_SOURCE[0]:-$0}"
[ -f "$SELF" ] && SELF="$(cd "$(dirname "$SELF")" && pwd)/$(basename "$SELF")"
CLAUDE_BIN="${CLAUDE_BIN:-$(command -v claude || echo claude)}"
MAX_SESSIONS="${CLAUDE_SESSIONS_MAX:-300}"
# ":"-separated Claude config dirs to scan; transcripts live in <dir>/projects.
# Anyone running two accounts side by side has a second tree (CLAUDE_CONFIG_DIR
# elsewhere), and its sessions are invisible to a picker that only reads
# ~/.claude. Missing dirs are skipped, so the default is safe on a one-account
# machine. Listed explicitly rather than globbed as ~/.claude*: a stale copy
# such as ~/.claude-backup would otherwise flood the picker with dead sessions.
export CS_CONFIG_DIRS="${CLAUDE_SESSIONS_CONFIG_DIRS:-$HOME/.claude:$HOME/.claude-personal}"

# ---------------------------------------------------------------- list -----
# Emits tab-separated lines: session_id <TAB> cwd <TAB> jsonl_path <TAB> display
# $1 = "all" (default) or "main" (hide teammate/agent sessions and headless `claude -p` runs)
list_sessions() {
  python3 - "$MAX_SESSIONS" "${1:-all}" <<'PY'
import glob, json, os, re, signal, sys, time
signal.signal(signal.SIGPIPE, signal.SIG_DFL)

max_n, mode = int(sys.argv[1]), sys.argv[2]
roots = [d for d in os.environ.get("CS_CONFIG_DIRS", "").split(":") if d]
files = [f for r in roots
         for f in glob.glob(os.path.join(r, "projects", "*", "*.jsonl"))
         if not os.path.basename(f).startswith("agent-")]
only = os.environ.get("CS_ONLY_FILES")  # full-text search: restrict to these paths
if only:
    with open(only) as fh:
        keep = {l.rstrip("\n") for l in fh}
    files = [f for f in files if f in keep and "/subagents/" not in f]
files.sort(key=os.path.getmtime, reverse=True)

DIM, CYAN, YELLOW, MAGENTA, BLUE, RESET = ("\033[2m", "\033[36m", "\033[33m",
                                           "\033[35m", "\033[34m", "\033[0m")

def account_of(path):  # "" for the default ~/.claude, else e.g. "personal"
    for r in roots:
        if path.startswith(r.rstrip("/") + "/"):
            name = os.path.basename(r.rstrip("/"))
            return "" if name == ".claude" else name.replace(".claude-", "")
    return ""

def age(ts):
    s = int(time.time() - ts)
    if s < 3600: return f"{s // 60}m"
    if s < 86400: return f"{s // 3600}h"
    return f"{s // 86400}d"

def text_parts(content):
    if isinstance(content, str): return [content]
    if isinstance(content, list):
        return [p.get("text", "") for p in content
                if isinstance(p, dict) and p.get("type") == "text"]
    return []

# Wrappers Claude Code injects around user-role messages; none is something the
# user typed. Blocks are dropped whole; <pasted_content> is unwrapped (its text
# IS the prompt).
INJECTED = re.compile(
    r"<(local-command-caveat|local-command-stdout|local-command-stderr|"
    r"bash-input|bash-stdout|bash-stderr|system-reminder|command-message)\b[^>]*>"
    r".*?(</\1>|$)", re.S)
PASTED = re.compile(r"</?pasted_content\b[^>]*>")
CMD_NAME = re.compile(r"<command-name>(.*?)</command-name>", re.S)
CMD_ARGS = re.compile(r"<command-args>(.*?)</command-args>", re.S)
# Built-in slash commands that are session plumbing, not a topic.
NOISE_CMDS = {"/clear", "/model", "/effort", "/compact", "/config", "/help",
              "/resume", "/exit", "/status", "/cost", "/context", "/rename",
              "/login", "/logout", "/mcp", "/permissions", "/fast", "/theme",
              "/vim", "/ide", "/usage", "/doctor", "/memory", "/agents", "/hooks"}
SKIP_PREFIXES = ("This session is being continued", "Caveat:",
                 "[Request interrupted", "Base directory for this skill")

def typed_prompt(e):
    """What the user actually typed in this user-role entry, or ''."""
    if e.get("isMeta"): return ""
    for t in text_parts(e.get("message", {}).get("content", "")):
        m = CMD_NAME.search(t)
        if m:
            name = m.group(1).strip()
            a = CMD_ARGS.search(t)
            args = a.group(1).strip() if a else ""
            if name in NOISE_CMDS and not args: continue
            return f"{name} {args}".strip()
        t = PASTED.sub("", INJECTED.sub("", t)).strip()
        if t and not t.startswith(SKIP_PREFIXES) and not t.startswith("<"):
            return t
    return ""

def wrapped_text(e):  # fallback: e.g. teammate prompts wrapped in injected <tags>
    for t in text_parts(e.get("message", {}).get("content", "")):
        t = INJECTED.sub("", t)
        t = re.sub(r"<[^>]*>", " ", t).strip()
        if t and not t.startswith(SKIP_PREFIXES): return t
    return ""

TITLE_KEYS = (("custom-title", "customTitle"), ("ai-title", "aiTitle"))

def scan_title(line, found):  # keep the LAST title entry seen, per kind
    for kind, key in TITLE_KEYS:
        if line.startswith('{"type":"%s"' % kind):
            try: found[kind] = json.loads(line).get(key, "") or found.get(kind, "")
            except Exception: pass

def session_title(path):
    """/rename title if any, else Claude's ai-title. Both are re-appended as the
    session grows, so the newest one lives near the end of the file."""
    found = {}
    try:
        with open(path, "rb") as fh:
            size = os.path.getsize(path)
            if size > 65536:
                fh.seek(-65536, 2)
                fh.readline()  # drop partial line
            for line in fh.read().decode(errors="replace").splitlines():
                scan_title(line, found)
        if len(found) < 2 and size > 65536:  # older titles only in the head
            with open(path, errors="replace") as fh:
                head = {}
                for i, line in enumerate(fh):
                    if i > 80: break
                    scan_title(line, head)
            for k, v in head.items(): found.setdefault(k, v)
    except OSError:
        return ""
    return " ".join((found.get("custom-title") or found.get("ai-title") or "").split())

TITLE_MAX = 200
shown = 0
home = os.path.expanduser("~")
for f in files:
    if shown >= max_n: break
    sid = cwd = branch = agent = entry = ""
    title = summary = raw = ""
    try:
        with open(f, errors="replace") as fh:
            for i, line in enumerate(fh):
                if i > 80 or (title and cwd): break
                try: e = json.loads(line)
                except Exception: continue
                if e.get("type") == "summary" and not summary:
                    summary = e.get("summary", "")
                if e.get("type") == "user" and not e.get("isSidechain"):
                    sid = sid or e.get("sessionId", "")
                    cwd = cwd or e.get("cwd", "")
                    branch = branch or (e.get("gitBranch") or "")
                    agent = agent or (e.get("agentName") or "")
                    entry = entry or (e.get("entrypoint") or "")
                    if not title:
                        title = typed_prompt(e)
                        raw = raw or wrapped_text(e)
    except OSError:
        continue
    if not sid or not cwd:
        continue
    is_agent = bool(agent) and agent != "team-lead"
    if mode == "main" and (is_agent or entry == "sdk-cli"):  # sdk-cli = headless `claude -p`
        continue
    named = session_title(f)  # searchable; also the fallback when nothing was typed
    if not title:
        title = named or summary or raw
    title = " ".join((title or "(no message)").split())[:TITLE_MAX]
    if named and named != title:  # dimmed, but part of the fzf search text
        title += f" {DIM}· {named[:80]}{RESET}"
    proj = cwd.replace(home, "~")
    if len(proj) > 34: proj = "…" + proj[-33:]
    br = f" {YELLOW}{branch[:14]}{RESET}" if branch and branch not in ("main", "master", "HEAD") else ""
    tag = f" {MAGENTA}⛭ {agent[:18]}{RESET}" if is_agent else ""
    acct = account_of(f)  # only non-default accounts are labelled
    acct = f" {BLUE}▸{acct[:10]}{RESET}" if acct else ""
    display = (f"{DIM}{age(os.path.getmtime(f)):>3}{RESET} "
               f"{CYAN}{proj:<34}{RESET}{acct}{tag}{br} {title}")
    print(f"{sid}\t{cwd}\t{f}\t{display}")
    shown += 1
PY
}

# Full-text search: transcripts (all config dirs, never /subagents/) that contain
# the query anywhere (rg if installed, else a python scan), listed newest first in the same row format. Fixed-string,
# case-insensitive; JSON-escaped characters (quotes, newlines) in a transcript
# won't match a query containing them.
search_sessions() {  # $2 = all|main like --list; default follows the picker's current list (fzf exports FZF_PROMPT)
  local q="${1:-}" tmp d mode="${2:-}"
  [ -n "$mode" ] || { [ "${FZF_PROMPT:-}" = 'main> ' ] && mode=main || mode=all; }
  [ -n "$q" ] || { list_sessions "$mode"; return; }
  tmp=$(mktemp)
  local dirs=()
  IFS=: read -ra roots <<<"$CS_CONFIG_DIRS"
  for d in "${roots[@]}"; do [ -d "$d/projects" ] && dirs+=("$d/projects"); done
  if [ "${#dirs[@]}" -gt 0 ]; then
    if command -v rg >/dev/null 2>&1; then
      rg -l -i -F --glob '*.jsonl' --glob '!**/subagents/**' -- "$q" "${dirs[@]}" >"$tmp" 2>/dev/null || true
    else
      # No rg: BSD grep -rli takes ~7 s over 800 MB of transcripts; python3 (already
      # required) does the same scan in ~0.4 s.
      python3 - "$q" "${dirs[@]}" >"$tmp" <<'PY' || true
import glob, os, sys
q = sys.argv[1]
ascii_q = q.isascii()  # bytes.lower() only folds ASCII; non-ASCII queries need str.casefold()
qb = q.lower().encode() if ascii_q else None
qf = None if ascii_q else q.casefold()
for d in sys.argv[2:]:
    for f in glob.glob(os.path.join(d, "*", "*.jsonl")):
        try:
            with open(f, "rb") as fh:
                data = fh.read()
            if ascii_q:
                if qb in data.lower(): print(f)
            elif qf in data.decode("utf-8", errors="replace").casefold(): print(f)
        except OSError:
            pass
PY
    fi
  fi
  CS_ONLY_FILES="$tmp" list_sessions "$mode"
  rm -f "$tmp"
}

# ------------------------------------------------------------- preview -----
preview_session() {
  python3 - "$1" <<'PY'
import json, os, sys

path = sys.argv[1]
size = os.path.getsize(path)
with open(path, "rb") as fh:
    if size > 300_000:
        fh.seek(-300_000, 2)
        fh.readline()  # drop partial line
    lines = fh.read().decode(errors="replace").splitlines()

BOLD, GREEN, BLUE, RESET = "\033[1m", "\033[32m", "\033[34m", "\033[0m"
out = []
for line in lines:
    try: e = json.loads(line)
    except Exception: continue
    role = e.get("type")
    if role not in ("user", "assistant") or e.get("isSidechain"): continue
    c = e.get("message", {}).get("content", "")
    if isinstance(c, list):
        c = "\n".join(p.get("text", "") for p in c
                      if isinstance(p, dict) and p.get("type") == "text")
    if not isinstance(c, str) or not c.strip() or c.startswith("<"): continue
    tag = f"{GREEN}{BOLD}user{RESET}" if role == "user" else f"{BLUE}{BOLD}claude{RESET}"
    out.append(f"{tag}: {c.strip()[:600]}")
print(f"\n\n".join(out[-15:]) or "(no readable messages)")
PY
}

# ---------------------------------------------------------------- open -----
open_one() {
  local id="$1" cwd="$2"
  [ -d "$cwd" ] || cwd="$HOME"
  if [ -n "${TMUX:-}" ]; then
    tmux new-window -c "$cwd" -n "$(basename "$cwd")" "$CLAUDE_BIN --resume $id"
  elif [ "${TERM_PROGRAM:-}" = "iTerm.app" ] || ps -axo comm | grep -q "MacOS/iTerm2$"; then
    osascript - "$cwd" "$id" "$CLAUDE_BIN" <<'EOF' >/dev/null
on run argv
  set theCmd to "cd " & quoted form of item 1 of argv & " && " & item 3 of argv & " --resume " & item 2 of argv
  tell application "iTerm"
    activate
    if (count of windows) is 0 then
      create window with default profile
    else
      tell current window to create tab with default profile
    end if
    tell current session of current window to write text theCmd
  end tell
end run
EOF
  else
    osascript - "$cwd" "$id" "$CLAUDE_BIN" <<'EOF' >/dev/null
on run argv
  set theCmd to "cd " & quoted form of item 1 of argv & " && " & item 3 of argv & " --resume " & item 2 of argv
  tell application "Terminal"
    activate
    do script theCmd
  end tell
end run
EOF
  fi
}

open_line() {  # $1 = file containing the highlighted tab-delimited line
  IFS=$'\t' read -r id cwd _rest < "$1"
  [ -n "$id" ] && open_one "$id" "$cwd"
}

# ------------------------------------------------------------ snapshot -----
# Dumps every iTerm tab (cwd + running claude session id, if any) to
# $SNAPSHOT_FILE. Run periodically (launchd) so a machine crash can be
# undone with --restore-crash. Skips writing when iTerm has no tabs, so a
# post-reboot run never clobbers the last good snapshot.
SNAPSHOT_FILE="${CLAUDE_SESSIONS_SNAPSHOT:-$HOME/.claude/terminal-snapshot.json}"
SNAPSHOT_DIR="${CLAUDE_SESSIONS_SNAPSHOT_DIR:-$HOME/.claude/terminal-snapshots}"
INSTALL_PATH="${CLAUDE_SESSIONS_INSTALL:-$HOME/.local/bin/claude-sessions}"
RAW_URL="https://raw.githubusercontent.com/DenverLifeSciences/claude-sessions/main/claude-sessions"
PLIST="$HOME/Library/LaunchAgents/com.claude.terminal-snapshot.plist"
UPDATE_CACHE="${CLAUDE_SESSIONS_UPDATE_CACHE:-$HOME/.claude/.claude-sessions-update}"
UPDATE_TTL="${CLAUDE_SESSIONS_UPDATE_TTL:-86400}"  # re-check GitHub at most once/day

# --------------------------------------------------------- install/update --
# GitHub is the single source of truth. --install fetches the latest script to
# a LOCAL path (launchd cannot read iCloud/cloud-synced paths — macOS TCC),
# wires up PATH + `cs` alias, and loads the snapshot timer. --update refreshes
# the installed copy in place. Both are idempotent; rerun freely.
self_install() {
  command -v python3 >/dev/null || { echo "missing dependency: python3" >&2; exit 1; }
  command -v fzf >/dev/null || echo "WARNING: fzf not found (brew install fzf) — picker won't work until installed" >&2
  mkdir -p "$(dirname "$INSTALL_PATH")"
  if curl -fsSL "$RAW_URL" -o "$INSTALL_PATH.tmp" 2>/dev/null; then
    mv "$INSTALL_PATH.tmp" "$INSTALL_PATH"
    echo "installed latest from GitHub -> $INSTALL_PATH"
  elif [ -f "$SELF" ] && [ "$SELF" != "$INSTALL_PATH" ]; then
    cp "$SELF" "$INSTALL_PATH"
    echo "offline: copied $SELF -> $INSTALL_PATH"
  else
    echo "install failed: cannot reach GitHub and no local copy to fall back on" >&2; exit 1
  fi
  chmod +x "$INSTALL_PATH"

  local zshrc="$HOME/.zshrc"
  grep -qs '/.local/bin' "$zshrc" || printf '\nexport PATH="$HOME/.local/bin:$PATH"\n' >> "$zshrc"
  grep -qs 'alias cs=' "$zshrc" || printf "alias cs='claude-sessions'\n" >> "$zshrc"

  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.claude.terminal-snapshot</string>
  <key>ProgramArguments</key>
  <array><string>$INSTALL_PATH</string><string>--snapshot</string></array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/tmp/claude-terminal-snapshot.log</string>
  <key>StandardErrorPath</key><string>/tmp/claude-terminal-snapshot.log</string>
</dict>
</plist>
EOF
  launchctl bootout "gui/$(id -u)/com.claude.terminal-snapshot" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$PLIST"
  echo "snapshot timer loaded (every 5 min) -> $SNAPSHOT_DIR"
  echo "done — open a new shell and run: cs"
}

self_update() {
  local target="$INSTALL_PATH"
  [ -f "$target" ] || target="$SELF"
  curl -fsSL "$RAW_URL" -o "$target.tmp" || { echo "update failed: cannot reach GitHub" >&2; exit 1; }
  if cmp -s "$target.tmp" "$target"; then
    rm -f "$target.tmp"; echo "already up to date: $target"
  else
    mv "$target.tmp" "$target" && chmod +x "$target"
    echo "updated $target"
  fi
}

# ------------------------------------------------------- update notifier ---
# The picker nags (once) when a newer version is on GitHub, WITHOUT ever
# blocking on the network: update_check_bg refreshes a cached flag in the
# background (throttled to UPDATE_TTL), update_notice reads that cache and
# prints instantly. So the notice reflects the *previous* run's check — which
# is exactly right for an update reminder. Cache line: "<checked-epoch> <0|1>".
update_check_bg() {
  [ -t 2 ] || return 0  # only from an interactive terminal, never launchd
  local now checked=0
  now=$(date +%s)
  [ -f "$UPDATE_CACHE" ] && read -r checked _ < "$UPDATE_CACHE" 2>/dev/null || true
  case "$checked" in ''|*[!0-9]*) checked=0 ;; esac
  [ $(( now - checked )) -ge "$UPDATE_TTL" ] || return 0  # checked recently
  ( target="$INSTALL_PATH"; [ -f "$target" ] || target="$SELF"
    tmp="$(mktemp)" || exit 0
    if curl -fsSL --max-time 5 "$RAW_URL" -o "$tmp" 2>/dev/null; then
      a=0; cmp -s "$tmp" "$target" || a=1
      printf '%s %s\n' "$(date +%s)" "$a" > "$UPDATE_CACHE"
    fi
    rm -f "$tmp" ) >/dev/null 2>&1 &
}

update_notice() {
  [ -t 2 ] || return 0
  local avail=0
  [ -f "$UPDATE_CACHE" ] && read -r _ avail < "$UPDATE_CACHE" 2>/dev/null || true
  [ "$avail" = "1" ] && printf '\033[33m▲ claude-sessions: a newer version is on GitHub — run `claude-sessions --update`\033[0m\n' >&2
  return 0
}

snapshot_state() {
  local dump
  dump=$(osascript <<'EOF' 2>/dev/null
set out to ""
tell application "iTerm"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        set out to out & (id of w) & "|" & (tty of s) & linefeed
      end repeat
    end repeat
  end repeat
end tell
return out
EOF
) || true
  SNAP_DUMP="$dump" python3 - "$SNAPSHOT_FILE" "$SNAPSHOT_DIR" <<'PY'
import glob, json, os, re, subprocess, sys, time

out_path, snap_dir = sys.argv[1], sys.argv[2]

def is_teammate(sid):
    # A TeamCreate teammate's transcript carries an `agentName` field; the
    # session you drove (or a solo session) has none, and the team lead is
    # "team-lead" — both count as yours. iTerm's tmux control-mode integration
    # surfaces each teammate pane as a native session, so the snapshot walk sees
    # them; skip so --restore-crash never resurrects a subagent window.
    if not sid: return False
    pats = [os.path.join(d, "projects", "*", sid + ".jsonl")
            for d in os.environ.get("CS_CONFIG_DIRS", "").split(":") if d]
    for f in [p for pat in pats for p in glob.glob(pat)]:
        try:
            with open(f, errors="replace") as fh:
                for i, line in enumerate(fh):
                    if i > 60: break
                    try: e = json.loads(line)
                    except Exception: continue
                    if "agentName" in e:
                        a = e.get("agentName") or ""
                        return bool(a) and a != "team-lead"
        except OSError:
            pass
    return False

tabs = []
for line in os.environ.get("SNAP_DUMP", "").splitlines():
    if "|" not in line: continue
    win, tty = line.split("|", 1)
    tty = tty.strip().replace("/dev/", "")
    if not tty: continue
    try:
        ps = subprocess.run(["ps", "-t", tty, "-o", "pid=,command="],
                            capture_output=True, text=True, timeout=10).stdout
    except Exception:
        continue
    shell_pid = claude_pid = None
    resume_id = None
    for pline in ps.splitlines():
        parts = pline.strip().split(None, 1)
        if len(parts) != 2: continue
        pid, cmd = parts
        if shell_pid is None and re.search(r"(^|/)-?(zsh|bash|fish)", cmd):
            shell_pid = pid
        if claude_pid is None and re.search(r"(^|/)claude( |$)", cmd):
            claude_pid = pid
            m = re.search(r"--resume[= ]([0-9a-f-]{36})", cmd)
            if m: resume_id = m.group(1)

    def cwd_of(pid):
        try:
            out = subprocess.run(["lsof", "-a", "-p", pid, "-d", "cwd", "-Fn"],
                                 capture_output=True, text=True, timeout=10).stdout
            for l in out.splitlines():
                if l.startswith("n"): return l[1:]
        except Exception:
            pass
        return None

    cwd = cwd_of(claude_pid or shell_pid) if (claude_pid or shell_pid) else None
    if not cwd: continue

    sid = resume_id
    if claude_pid and not sid:
        # exact match: the transcript claude holds open
        try:
            out = subprocess.run(["lsof", "-p", claude_pid, "-Fn"],
                                 capture_output=True, text=True, timeout=10).stdout
            m = re.search(r"\.claude[^/]*/projects/[^\n]*/([0-9a-f-]{36})\.jsonl", out)
            if m: sid = m.group(1)
        except Exception:
            pass
    if claude_pid and not sid:
        # fallback: newest transcript for this cwd's project dir
        slug = re.sub(r"[/.]", "-", cwd)
        js = []
        for d in os.environ.get("CS_CONFIG_DIRS", "").split(":"):
            if not d: continue
            proj = os.path.join(d, "projects", slug)
            try:
                js += [os.path.join(proj, f) for f in os.listdir(proj) if f.endswith(".jsonl")]
            except OSError:
                pass
        if js: sid = os.path.basename(max(js, key=os.path.getmtime))[:-6]
    if is_teammate(sid):  # subagent/teammate window — not one of the user's
        continue
    tabs.append({"window": win.strip(), "cwd": cwd, "claudeSession": sid})

if not tabs:  # never overwrite a good snapshot with an empty one
    print("snapshot: no iTerm tabs found; keeping previous snapshots")
    sys.exit(0)

os.makedirs(snap_dir, exist_ok=True)
history = sorted(glob.glob(os.path.join(snap_dir, "*.json")))
if history:
    try:
        if json.load(open(history[-1])).get("tabs") == tabs:
            print(f"snapshot: unchanged ({len(tabs)} tab(s)); keeping {history[-1]}")
            sys.exit(0)
    except Exception:
        pass

data = {"takenAt": int(time.time()), "tabs": tabs}
hist_path = os.path.join(snap_dir, f"{data['takenAt']}.json")
json.dump(data, open(hist_path, "w"), indent=1)
for old in history[:-100]:  # keep last ~100 distinct states
    os.remove(old)
print(f"snapshot: {len(tabs)} tab(s) -> {hist_path}")
PY
}

restore_crash() {  # $1 (optional) = specific snapshot file; default: newest
  python3 - "${1:-}" "$SNAPSHOT_FILE" "$SNAPSHOT_DIR" "$CLAUDE_BIN" <<'PY'
import glob, json, os, shlex, subprocess, sys, time

arg, latest, snap_dir, claude_bin = sys.argv[1:5]

def is_teammate(sid):
    # See snapshot_state: teammate transcripts carry a non-"team-lead" agentName.
    # Applied here too so OLD snapshots (taken before snapshot-time filtering)
    # don't resurrect subagent windows.
    if not sid: return False
    pats = [os.path.join(d, "projects", "*", sid + ".jsonl")
            for d in os.environ.get("CS_CONFIG_DIRS", "").split(":") if d]
    for f in [p for pat in pats for p in glob.glob(pat)]:
        try:
            with open(f, errors="replace") as fh:
                for i, line in enumerate(fh):
                    if i > 60: break
                    try: e = json.loads(line)
                    except Exception: continue
                    if "agentName" in e:
                        a = e.get("agentName") or ""
                        return bool(a) and a != "team-lead"
        except OSError:
            pass
    return False

def n_sessions(p):  # the user's own live claude sessions in a snapshot file
    try:
        return sum(1 for t in json.load(open(p)).get("tabs", [])
                   if t.get("claudeSession") and not is_teammate(t["claudeSession"]))
    except Exception:
        return 0

path = arg
if not path:
    # Default: newest snapshot that actually has live claude sessions. A reboot
    # (or sleep/crash) kills every claude process but iTerm restores the bare
    # shells, so the first post-reboot snapshot has tabs but 0 sessions — a husk.
    # Skip those so `--restore-crash` never lands on a session-less state.
    history = sorted(glob.glob(os.path.join(snap_dir, "*.json")))  # oldest -> newest
    healthy = [p for p in history if n_sessions(p) > 0]
    if healthy:
        path = healthy[-1]
        skipped = len(history) - 1 - history.index(path)
        if skipped:
            print(f"skipped {skipped} newer session-less snapshot(s) (likely post-reboot "
                  f"shells); restoring newest snapshot with live sessions")
    elif history:
        path = history[-1]
        print("warning: no snapshot has live claude sessions; restoring newest anyway")
    else:
        path = latest
if not path or not os.path.exists(path):
    sys.exit("no snapshot found (looked in %s and %s)" % (snap_dir, latest))
snap = json.load(open(path))
age_min = (time.time() - snap["takenAt"]) / 60
all_tabs = snap["tabs"]
tabs = [t for t in all_tabs if not is_teammate(t.get("claudeSession"))]
skipped_agents = len(all_tabs) - len(tabs)
snap["tabs"] = tabs
if skipped_agents:
    print(f"skipped {skipped_agents} subagent/teammate window(s)")
print(f"restoring {len(snap['tabs'])} tab(s) from {path} (taken {age_min:.0f} min ago)")

# All snapshot tabs are restored as tabs of the CURRENT window (the one the
# command runs in), regardless of how they were grouped into windows before —
# one window to rule them all, and the initiating tab is left untouched.
script = ['tell application "iTerm"', "activate",
          "if (count of windows) is 0 then create window with default profile"]
for tab in snap["tabs"]:
    cmd = "cd " + shlex.quote(tab["cwd"])
    if tab.get("claudeSession"):
        cmd += f" && {claude_bin} --resume {tab['claudeSession']}"
    esc = cmd.replace("\\", "\\\\").replace('"', '\\"')
    script.append("tell current window to create tab with default profile")
    script.append(f'tell current session of current window to write text "{esc}"')
script.append("end tell")
subprocess.run(["osascript", "-e", "\n".join(script)], check=True)
for tab in snap["tabs"]:
    mark = "claude --resume " + tab["claudeSession"] if tab.get("claudeSession") else "shell"
    print(f"  {tab['cwd']}  [{mark}]")
PY
}

pick_snapshot() {  # browse snapshot history in fzf, restore the chosen one
  local chosen
  chosen=$(python3 - "$SNAPSHOT_DIR" <<'PY'
import glob, json, os, sys, time
for f in sorted(glob.glob(os.path.join(sys.argv[1], "*.json")), reverse=True):
    try: s = json.load(open(f))
    except Exception: continue
    mins = int((time.time() - s["takenAt"]) / 60)
    age = f"{mins}m" if mins < 60 else (f"{mins//60}h" if mins < 1440 else f"{mins//1440}d")
    n_claude = sum(1 for t in s["tabs"] if t.get("claudeSession"))
    cwds = ", ".join(sorted({os.path.basename(t["cwd"]) or "~" for t in s["tabs"]})[:4])
    print(f"{f}\t{age:>4} ago  {len(s['tabs'])} tabs ({n_claude} claude)  {cwds}")
PY
) || true
  [ -n "$chosen" ] || { echo "no snapshots in $SNAPSHOT_DIR" >&2; exit 1; }
  chosen=$(echo "$chosen" | fzf --delimiter '\t' --with-nth 2.. --no-sort \
    --header 'pick the terminal state to restore' | cut -f1)
  [ -n "$chosen" ] && restore_crash "$chosen"
}

# ------------------------------------------------------------------ tmux ---
# `claude-sessions tmux ...` is the tmux counterpart of --snapshot/--restore-crash.
# tmux does NOT survive a reboot: the server is a process and dies with everything
# else, and the iTerm snapshot can't see inside it. This saves what matters
# (session name, window names, per-window cwd, and the Claude session id running
# in each) to a plain-text file, and replays it afterwards with
# `claude --resume <id>` per window.
TMUX_LAYOUT="${CLAUDE_SESSIONS_TMUX_LAYOUT:-$HOME/.claude/tmux-layout.tsv}"
# Absolute path: under launchd there is no PATH, and python3 can be a
# version-manager shim that needs one. The system python3 has every module used here.
TMUX_PY=/usr/bin/python3; [ -x "$TMUX_PY" ] || TMUX_PY=python3
TMUX_BIN="${CLAUDE_SESSIONS_TMUX_BIN:-$(command -v tmux 2>/dev/null || echo /opt/homebrew/bin/tmux)}"
TMUX_LABEL=com.claude.tmux-layout
TMUX_PLIST="$HOME/Library/LaunchAgents/$TMUX_LABEL.plist"
# The layout file is rewritten every tick, so after a crash a fresh tmux server would
# replace it. History keeps the last TMUX_HISTORY_KEEP distinct layouts that still have
# a resumable session, and restore reads from there.
TMUX_HISTORY="${CLAUDE_SESSIONS_TMUX_HISTORY:-$HOME/.claude/tmux-layouts}"
TMUX_HISTORY_KEEP="${CLAUDE_SESSIONS_TMUX_HISTORY_KEEP:-20}"

# Record the just-saved layout in history unless it has no session id to resume
# (a fresh post-crash tmux server) or equals the newest entry.
tmux_history_add() {
  awk -F'\t' '$5 != "" { f = 1 } END { exit !f }' "$TMUX_LAYOUT" || return 0
  mkdir -p "$TMUX_HISTORY"
  local files=() new i n
  shopt -s nullglob; files=("$TMUX_HISTORY"/*.tsv); shopt -u nullglob
  n=${#files[@]}
  if [ "$n" -gt 0 ] && cmp -s "${files[n-1]}" "$TMUX_LAYOUT"; then return 0; fi
  new="$TMUX_HISTORY/$(date +%s).tsv"
  [ -e "$new" ] || files+=("$new")   # two saves in one second share a name
  cp "$TMUX_LAYOUT" "$new"
  n=${#files[@]}
  for ((i = 0; i < n - TMUX_HISTORY_KEEP; i++)); do rm -f "${files[i]}"; done
}

# Path of the layout restore/show/export use: the newest history entry, else the layout file.
tmux_default_layout() {
  local files=()
  if [ -n "$TMUX_HISTORY" ]; then
    shopt -s nullglob; files=("$TMUX_HISTORY"/*.tsv); shopt -u nullglob
  fi
  if [ ${#files[@]} -gt 0 ]; then echo "${files[${#files[@]}-1]}"; else echo "$TMUX_LAYOUT"; fi
}

# Choose an earlier layout from history in fzf; prints its path.
tmux_pick_layout() {
  local chosen
  [ -n "$(ls -A "$TMUX_HISTORY" 2>/dev/null)" ] || { echo "no layout history in $TMUX_HISTORY yet (it fills as the timer runs: claude-sessions tmux install-timer)" >&2; return 1; }
  command -v fzf >/dev/null || { echo "missing dependency: fzf (brew install fzf)" >&2; return 1; }
  chosen=$(CS_TMUX_HISTORY="$TMUX_HISTORY" "$TMUX_PY" - <<'PY' | fzf --delimiter '\t' --with-nth 2.. --no-sort \
    --header 'pick the tmux layout to restore' | cut -f1
import glob, os, time
for f in sorted(glob.glob(os.path.join(os.environ["CS_TMUX_HISTORY"], "*.tsv")), reverse=True):
    rows = [r for r in (l.rstrip("\n").split("\t") for l in open(f)) if len(r) == 5]
    mins = int((time.time() - int(os.path.basename(f)[:-4])) / 60)
    age = f"{mins}m" if mins < 60 else (f"{mins//60}h" if mins < 1440 else f"{mins//1440}d")
    n_claude = sum(1 for r in rows if r[4])
    names = ", ".join(r[2] for r in rows[:5]) + (", ..." if len(rows) > 5 else "")
    print(f"{f}\t{age:>4} ago  {len(rows)} windows ({n_claude} claude)  {names}")
PY
  ) || true
  [ -n "$chosen" ] && echo "$chosen"
}

tmux_save() {
  local filter="${1:-}" tmpf
  tmpf=$(mktemp)
  CS_TMUX_FILTER="$filter" CS_TMUX_BIN="$TMUX_BIN" "$TMUX_PY" - "$tmpf" <<'PY'
import datetime, glob, json, os, re, subprocess, sys

out_path = sys.argv[1]
filter_sess = os.environ.get("CS_TMUX_FILTER", "")
tmux = os.environ.get("CS_TMUX_BIN", "tmux")

# ---------------------------------------------------------------- registry ---
# Claude Code maintains ~/.claude/sessions/<pid>.json for every live session:
#   {"pid":.., "sessionId":.., "cwd":.., "startedAt":<epoch ms>,
#    "kind":"interactive", "tmux":"<sess>:@<win-id>.%<pane-id>", ...}
# This is authoritative. It beats both older heuristics:
#   - the `--resume <id>` argument goes stale (resuming forks a NEW session id,
#     so the id on the command line is last week's conversation, not this one)
#   - "newest .jsonl in the project dir" collapses every window sharing a cwd
#     onto whichever session wrote most recently — usually the wrong one.
def proc_start(pid):
    try:
        ls = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)],
                            capture_output=True, text=True, timeout=10).stdout.strip()
        return datetime.datetime.strptime(ls, "%a %b %d %H:%M:%S %Y").timestamp()
    except Exception:
        return None

by_pane, by_pid = {}, {}
for f in glob.glob(os.path.expanduser("~/.claude/sessions/*.json")):
    try:
        d = json.load(open(f))
    except Exception:
        continue
    pid, sid = d.get("pid"), d.get("sessionId")
    if not pid or not sid:
        continue
    if d.get("kind") != "interactive":   # skip subagents / non-interactive runs
        continue
    # Guard against pid reuse: the live process must have started when the
    # registry says it did. Measured drift between startedAt and ps lstart is
    # under 5s; 120s is slack enough to never reject a genuine match.
    ps_start = proc_start(pid)
    if ps_start is None:                 # pid is gone -> stale entry
        continue
    started = d.get("startedAt")
    if started and abs(ps_start - started / 1000.0) > 120:
        continue
    by_pid[str(pid)] = sid
    m = re.search(r"(%\d+)$", str(d.get("tmux") or ""))
    if m:
        by_pane[m.group(1)] = sid

# -------------------------------------------------------------- tmux panes ---
fmt = "\t".join("#{%s}" % k for k in (
    "session_name", "window_index", "window_name", "pane_id",
    "pane_pid", "pane_current_path", "pane_current_command"))
try:
    panes = subprocess.run([tmux, "list-panes", "-a", "-F", fmt],
                           capture_output=True, text=True, timeout=20).stdout
except Exception as e:
    # No tmux server (e.g. the 5-min timer firing before you reattach after a
    # reboot). Exit non-zero WITHOUT writing, so the last good layout survives.
    sys.stderr.write("tmux not reachable (%s); keeping previous layout\n" % e)
    sys.exit(1)

def children(pid):
    try:
        return subprocess.run(["pgrep", "-P", str(pid)],
                              capture_output=True, text=True, timeout=10).stdout.split()
    except Exception:
        return []

rows, seen = [], set()
for line in panes.splitlines():
    p = line.split("\t")
    if len(p) != 7:
        continue
    sess, widx, wname, pane_id, pane_pid, cwd, pcmd = p
    if filter_sess and sess != filter_sess:
        continue
    if (sess, widx) in seen:             # one row per window, not per pane
        continue

    sid = by_pane.get(pane_id)                       # 1. registry, by pane id
    if not sid:                                      # 2. registry, by pid
        for c in [pane_pid] + children(pane_pid):
            if c in by_pid:
                sid = by_pid[c]
                break
    if not sid:                                      # 3. --resume argument
        for c in children(pane_pid):
            try:
                args = subprocess.run(["ps", "-o", "command=", "-p", c],
                                      capture_output=True, text=True, timeout=10).stdout
            except Exception:
                continue
            m = re.search(r"--resume[= ]([0-9a-f-]{36})", args)
            if m:
                sid = m.group(1)
                break
    # No 4th tier. If the registry has nothing and no id is on the command line,
    # this window has no Claude session worth resuming — record it with an empty
    # id so restore opens a fresh `claude` there, rather than guessing wrong.

    if wname == pcmd:    # auto-named window (name == running command) is useless later
        wname = os.path.basename(cwd)
    seen.add((sess, widx))
    rows.append("\t".join((sess, widx, wname, cwd, sid or "")))

if not rows:
    sys.stderr.write("no tmux panes found; keeping previous layout\n")
    sys.exit(1)
open(out_path, "w").write("\n".join(rows) + "\n")
PY
  [ -s "$tmpf" ] || { rm -f "$tmpf"; exit 1; }
  mkdir -p "$(dirname "$TMUX_LAYOUT")"
  mv "$tmpf" "$TMUX_LAYOUT"
  [ -z "$TMUX_HISTORY" ] || tmux_history_add
  echo "saved $(wc -l < "$TMUX_LAYOUT" | tr -d ' ') window(s) -> $TMUX_LAYOUT"
  tmux_show "$TMUX_LAYOUT"
}

tmux_show() {  # [layout-file]; default: the layout restore would use
  local file="${1:-$(tmux_default_layout)}"
  [[ -f "$file" ]] || { echo "no layout saved at $file" >&2; exit 1; }
  awk -F'\t' -v home="$HOME" -v ell="…" '{
    d=$4; sub("^" home, "~", d)
    id=($5=="" ? "(fresh)" : substr($5,1,8) ell)
    printf "  %s:%s  %-16s %-34s %s\n", $1, $2, $3, d, id
  }' "$file"
}

tmux_restore() {  # [--pick | <layout-file>]; default: the newest saved layout that has a resumable session
  local file n=0
  case "${1:-}" in
    --pick) file=$(tmux_pick_layout) || exit 1 ;;
    "")     file=$(tmux_default_layout) ;;
    *)      file="$1" ;;
  esac
  [[ -f "$file" ]] || { echo "no layout saved at $file" >&2; exit 1; }
  while IFS=$'\t' read -r sess widx wname cwd sid; do
    [[ -z "$sess" ]] && continue
    [[ -d "$cwd" ]] || { echo "skip $sess:$widx — missing dir $cwd" >&2; continue; }
    local run="$CLAUDE_BIN"
    [[ -n "$sid" ]] && run="$CLAUDE_BIN --resume $sid"
    # keep the pane alive after claude exits, so a bad resume isn't a vanished window
    local shellcmd="cd $(printf %q "$cwd") && $run; exec \$SHELL -l"
    if "$TMUX_BIN" has-session -t "=$sess" 2>/dev/null; then
      "$TMUX_BIN" new-window -t "=$sess" -n "$wname" -c "$cwd" "$shellcmd"
    else
      "$TMUX_BIN" new-session -d -s "$sess" -n "$wname" -c "$cwd" "$shellcmd"
    fi
    n=$((n + 1))
  done < "$file"
  echo "restored $n window(s) from $file"
  echo "attach with: tmux attach -t $(head -1 "$file" | cut -f1)    (an earlier layout: claude-sessions tmux restore --pick)"
}

# Printable list of every Claude session id + the folder to resume it from, for
# saving by hand. Three sections: running in tmux, running outside tmux, and
# saved-but-not-running (everything, after a reboot), read from the newest saved
# layout. The live view goes to a temp file, and not into history, so exporting
# never touches what restore uses.
tmux_export() {
  local live; live=$(mktemp)
  ( TMUX_LAYOUT="$live"; TMUX_HISTORY=""; tmux_save ) >/dev/null 2>&1 || true
  local rc=0
  CS_TMUX_LIVE="$live" CS_TMUX_SAVED="$(tmux_default_layout)" "$TMUX_PY" - <<'PY' || rc=$?
import datetime, glob, json, os, subprocess, sys

home = os.path.expanduser("~")
short = lambda p: "~" + p[len(home):] if p == home or p.startswith(home + "/") else p

def rows(path):
    out = []
    try:
        for l in open(path):
            p = l.rstrip("\n").split("\t")
            if len(p) == 5 and p[0] and p[4]:    # skip fresh windows: no id to export
                out.append(p)
    except OSError:
        pass
    return out

def proc_start(pid):
    try:
        ls = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)],
                            capture_output=True, text=True, timeout=10).stdout.strip()
        return datetime.datetime.strptime(ls, "%a %b %d %H:%M:%S %Y").timestamp()
    except Exception:
        return None

# Live interactive sessions from Claude's registry (same pid-reuse guard as save).
reg = {}
for f in glob.glob(home + "/.claude/sessions/*.json"):
    try:
        d = json.load(open(f))
    except Exception:
        continue
    pid, sid = d.get("pid"), d.get("sessionId")
    if not pid or not sid or d.get("kind") != "interactive":
        continue
    ps_start, started = proc_start(pid), d.get("startedAt")
    if ps_start is None or (started and abs(ps_start - started / 1000.0) > 120):
        continue
    reg[sid] = d.get("cwd") or ""

live, saved = rows(os.environ["CS_TMUX_LIVE"]), rows(os.environ["CS_TMUX_SAVED"])
in_tmux = {r[4] for r in live}
running = in_tmux | set(reg)
outside = [(sid, cwd) for sid, cwd in reg.items() if sid not in in_tmux]
not_running = [r for r in saved if r[4] not in running]

if not (live or outside or not_running):
    sys.stderr.write("nothing to export: no live sessions and no saved layout\n")
    sys.exit(1)

def key(r):
    return (r[0], int(r[1]) if r[1].isdigit() else 0)

print("# Claude sessions - " + datetime.datetime.now().strftime("%Y-%m-%d %H:%M"))
print("# restore: cd <folder> && claude --resume <id>")
if live:
    print("\n## running in tmux")
    for sess, widx, name, cwd, sid in sorted(live, key=key):
        print(f"{sess + ':' + widx:<10}{name:<16}{sid}   {short(cwd)}")
if outside:
    print("\n## running outside tmux")
    for sid, cwd in sorted(outside, key=lambda x: x[1]):
        print(f"{'-':<10}{'-':<16}{sid}   {short(cwd)}")
if not_running:
    when = datetime.datetime.fromtimestamp(os.path.getmtime(os.environ["CS_TMUX_SAVED"])).strftime("%Y-%m-%d %H:%M")
    print(f"\n## in saved layout ({when}), not running now")
    for sess, widx, name, cwd, sid in sorted(not_running, key=key):
        print(f"{sess + ':' + widx:<10}{name:<16}{sid}   {short(cwd)}")
PY
  rm -f "$live"
  return $rc
}

tmux_install_timer() {
  local prog="$INSTALL_PATH"; [ -x "$prog" ] || prog="$SELF"
  mkdir -p "$(dirname "$TMUX_PLIST")"
  cat > "$TMUX_PLIST" <<PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$TMUX_LABEL</string>
  <key>ProgramArguments</key>
  <array><string>$prog</string><string>tmux</string><string>save</string></array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/tmp/claude-tmux-layout.log</string>
  <key>StandardErrorPath</key><string>/tmp/claude-tmux-layout.log</string>
</dict>
</plist>
PLISTEOF
  launchctl bootout "gui/$(id -u)/$TMUX_LABEL" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$TMUX_PLIST"
  echo "timer loaded (every 5 min) -> $TMUX_LAYOUT   log: /tmp/claude-tmux-layout.log"
}

tmux_uninstall_timer() {
  launchctl bootout "gui/$(id -u)/$TMUX_LABEL" 2>/dev/null || true
  rm -f "$TMUX_PLIST"
  echo "timer removed"
}

tmux_usage() {  # $1 = exit code: 0 (asked for) prints to stdout, otherwise stderr
  local rc="${1:-2}" fd=2
  [ "$rc" -eq 0 ] && fd=1
  cat >&"$fd" <<'EOF'
usage: claude-sessions tmux <command>

Save and restore the Claude sessions running in tmux windows.

  save [session]    snapshot the tmux windows now (the timer does this every 5 min)
  show [file]       print the newest saved layout (or the given one)
  restore [file]    after a reboot: recreate every window of the newest saved layout,
                    resuming each session
  restore --pick    choose an earlier layout (the last 20 distinct ones are kept in
                    ~/.claude/tmux-layouts, so a fresh tmux after a crash can't erase them)
  export            print a list of session ids + folders, to keep by hand
  install-timer     snapshot every 5 min (launchd agent com.claude.tmux-layout)
  uninstall-timer   remove that timer
EOF
  exit "$rc"
}

tmux_main() {
  case "${1:-}" in
    save)            shift; tmux_save "${1:-}" ;;
    show)            shift; tmux_show "${1:-}" ;;
    restore)         shift; tmux_restore "${1:-}" ;;
    export)          tmux_export ;;
    install-timer)   tmux_install_timer ;;
    uninstall-timer) tmux_uninstall_timer ;;
    ""|-h|--help)    tmux_usage 0 ;;
    *)               echo "claude-sessions tmux: unknown command: $1" >&2; tmux_usage ;;
  esac
}

usage() {  # $1 = exit code: 0 (asked for) prints to stdout, otherwise stderr
  local rc="${1:-2}" fd=2
  [ "$rc" -eq 0 ] && fd=1
  cat >&"$fd" <<'EOF'
claude-sessions: find and resume Claude Code sessions, and rebuild your terminal after a reboot.

usage: claude-sessions [command]

Find a session
  (no command)                  interactive session picker (fzf)
  --list [all|main]             print sessions (tab-separated)
  --search <text> [all|main]    print sessions whose transcript contains <text>

Recover iTerm tabs after a crash
  --snapshot                    snapshot iTerm tabs + Claude sessions now
  --restore-crash [file]        restore the newest (or the given) snapshot
  --restore-pick                choose a snapshot from history to restore

Recover tmux windows after a reboot       (run `claude-sessions tmux` for details)
  tmux save | show              snapshot / print the saved tmux layout
  tmux restore [--pick]         recreate every saved window, resuming each session
  tmux export                   print session ids + folders, to keep by hand
  tmux install-timer            snapshot tmux windows every 5 min (launchd)
  tmux uninstall-timer          remove that timer

Set up
  --install                     install the script, PATH, `cs` alias and iTerm snapshot timer
  --update                      refresh the installed copy from GitHub
  -h, --help                    show this help
EOF
  exit "$rc"
}

# ---------------------------------------------------------------- main -----
case "${1:-}" in
  --list)       list_sessions "${2:-all}" ;;
  --search)     search_sessions "${2:-}" "${3:-}" ;;
  --preview)    preview_session "$2" ;;
  --open-line)  open_line "$2" ;;
  --snapshot)      snapshot_state ;;
  --restore-crash) restore_crash "${2:-}" ;;
  --restore-pick)  pick_snapshot ;;
  --install)       self_install ;;
  --update)        self_update ;;
  tmux)            shift; tmux_main "$@" ;;
  -h|--help)       usage 0 ;;
  ?*)              echo "claude-sessions: unknown argument: $1" >&2; usage ;;
  *)
    update_check_bg
    list_sessions main | fzf --ansi --delimiter '\t' --with-nth 4.. --exact --no-hscroll \
      --prompt 'main> ' --no-sort --layout=reverse --info=inline \
      --header 'enter: open in new tab (picker stays)  |  ctrl-a: hide/show ⛭ agents + headless runs  |  ctrl-s: full-text search of transcripts  |  ctrl-r: refresh / back to list  |  esc: quit' \
      --preview "'$SELF' --preview {3}" --preview-window 'down,50%,wrap' \
      --bind "enter:execute-silent('$SELF' --open-line {f})" \
      --bind "ctrl-r:change-prompt(main> )+reload('$SELF' --list main)" \
      --bind "ctrl-s:transform:[ \"\$FZF_PROMPT\" = '> ' ] \
        && echo \"change-prompt(text> )+reload('$SELF' --search {q} all)+clear-query\" \
        || echo \"change-prompt(text> )+reload('$SELF' --search {q} main)+clear-query\"" \
      --bind "ctrl-a:transform:[ \"\$FZF_PROMPT\" = 'main> ' ] \
        && echo \"change-prompt(> )+reload('$SELF' --list all)\" \
        || echo \"change-prompt(main> )+reload('$SELF' --list main)\"" \
      >/dev/null || true
    update_notice
    ;;
esac
